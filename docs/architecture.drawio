          <mxGeometry x="70" y="485" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="disp" value="Dispatcher Lambda" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#ED7100;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="290" y="385" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sm2" value="State machine&lt;br&gt;Standard: async&lt;br&gt;Express: sync" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#E7157B;resIcon=mxgraph.aws4.step_functions;" vertex="1" parent="1">
          <mxGeometry x="520" y="385" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="err2" value="Error queue&lt;br&gt;(async only)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#E7157B;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1">
          <mxGeometry x="740" y="470" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- Shared worker -->
        <mxCell id="worker" value="Worker Lambda&lt;br&gt;(shared)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=4;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#ED7100;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="960" y="265" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- Normal flow -->
        <mxCell id="e-src1-pipe" value="poll" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=11;fontColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="src1" target="pipe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-pipe-sm1" value="StartExecution or&lt;br&gt;StartSyncExecution" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=11;fontColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pipe" target="sm1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-src2-disp" value="event source&lt;br&gt;mapping" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=11;fontColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="src2" target="disp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-disp-sm2" value="StartExecution or&lt;br&gt;StartSyncExecution" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=11;fontColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="disp" target="sm2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-sm1-worker" value="invoke" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=11;fontColor=#545B64;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="sm1" target="worker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-sm2-worker" value="invoke" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=11;fontColor=#545B64;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="sm2" target="worker">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="990" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Where a failed message ends up -->
        <mxCell id="e-src1-dlq1" value="after 3 receives" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#DD344C;fontSize=11;fontColor=#DD344C;labelBackgroundColor=#ffffff;align=left;spacingLeft=6;" edge="1" parent="1" source="src1" target="dlq1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-sm1-err1" value="Catch" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#DD344C;fontSize=11;fontColor=#DD344C;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="sm1" target="err1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-src2-dlq2" value="after 3 receives" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#DD344C;fontSize=11;fontColor=#DD344C;labelBackgroundColor=#ffffff;align=left;spacingLeft=6;" edge="1" parent="1" source="src2" target="dlq2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-sm2-err2" value="Catch" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#DD344C;fontSize=11;fontColor=#DD344C;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="sm2" target="err2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Note -->
        <mxCell id="note" value="Red dashed lines: where a failed message ends up. Sync: SQS keeps the message and moves it to the DLQ after 3 receives. Async: the workflow catches the error and writes the record to the error queue. A failed start goes to the DLQ in both cases." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;" vertex="1" parent="1">
          <mxGeometry x="20" y="595" width="1000" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
