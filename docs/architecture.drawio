<mxfile host="drawio">
  <diagram id="overview" name="Overview">
    <mxGraphModel dx="1200" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Containers -->
        <mxCell id="pipe-group" value="Pipe scenarios P1–P4" style="rounded=1;arcSize=3;fillColor=none;strokeColor=#879196;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#232F3E;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="840" height="265" as="geometry" />
