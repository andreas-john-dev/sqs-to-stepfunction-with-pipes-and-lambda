        <mxCell id="lambda-group" value="Lambda scenarios L1–L5" style="rounded=1;arcSize=3;fillColor=none;strokeColor=#879196;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#232F3E;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="310" width="840" height="265" as="geometry" />
        </mxCell>

        <!-- Pipe row -->
        <mxCell id="src1" value="Source queue" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#E7157B;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1">
          <mxGeometry x="70" y="95" width="60" height="60" as="geometry" />
